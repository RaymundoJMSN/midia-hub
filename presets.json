{
  "img-menor": {
    "rotulo": "Comprimir (recomendado — some ~70%, olho não nota)",
    "categoria": "imagem",
    "exts": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp", ".avif"],
    "saida_ext": ".webp",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c:v", "libwebp", "-preset", "picture", "-quality", "85", "-y", "{out}"]
  },
  "img-muito-menor": {
    "rotulo": "Comprimir muito (bem pequena, perde um pouquinho)",
    "categoria": "imagem",
    "exts": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp", ".avif"],
    "saida_ext": ".webp",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c:v", "libwebp", "-preset", "picture", "-quality", "70", "-y", "{out}"]
  },
  "img-pouca-compressao": {
    "rotulo": "Comprimir pouco (praticamente idêntica)",
    "categoria": "imagem",
    "exts": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp", ".avif"],
    "saida_ext": ".webp",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c:v", "libwebp", "-preset", "picture", "-quality", "95", "-y", "{out}"]
  },
  "img-sem-perda": {
    "rotulo": "Sem perda nenhuma (100% idêntica, comprime menos)",
    "categoria": "imagem",
    "exts": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp"],
    "saida_ext": ".webp",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c:v", "libwebp", "-lossless", "1", "-compression_level", "6", "-y", "{out}"]
  },
  "img-minima": {
    "rotulo": "Menor tamanho possível (AVIF — mais lento)",
    "categoria": "imagem",
    "exts": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp"],
    "saida_ext": ".avif",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c:v", "libaom-av1", "-still-picture", "1", "-crf", "30", "-b:v", "0", "-cpu-used", "6", "-pix_fmt", "yuv420p", "-y", "{out}"]
  },
  "img-tela-1920": {
    "rotulo": "Diminuir p/ tamanho de tela (1920px)",
    "categoria": "imagem",
    "exts": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp", ".avif"],
    "saida_ext": ".webp",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-vf", "scale=w='min(iw,1920)':h='min(ih,1920)':force_original_aspect_ratio=decrease", "-c:v", "libwebp", "-preset", "picture", "-quality", "85", "-y", "{out}"]
  },
  "img-zap-1280": {
    "rotulo": "Diminuir p/ mandar no zap (1280px)",
    "categoria": "imagem",
    "exts": [".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp", ".avif"],
    "saida_ext": ".webp",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-vf", "scale=w='min(iw,1280)':h='min(ih,1280)':force_original_aspect_ratio=decrease", "-c:v", "libwebp", "-preset", "picture", "-quality", "80", "-y", "{out}"]
  },
  "img-para-jpg": {
    "rotulo": "Converter p/ JPG (abre em qualquer lugar)",
    "categoria": "imagem",
    "exts": [".png", ".bmp", ".tif", ".tiff", ".webp", ".avif"],
    "saida_ext": ".jpg",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-q:v", "3", "-y", "{out}"]
  },
  "gif-para-video": {
    "rotulo": "GIF → vídeo MP4 (fica ~90% menor)",
    "categoria": "imagem",
    "exts": [".gif"],
    "saida_ext": ".mp4",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-movflags", "faststart", "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2", "-pix_fmt", "yuv420p", "-c:v", "libx264", "-crf", "23", "-y", "{out}"]
  },
  "ia-aumentar-4x": {
    "rotulo": "Aumentar 4x o tamanho (IA)",
    "categoria": "ia",
    "exts": [".jpg", ".jpeg", ".png", ".webp"],
    "cmd": ["{realesrgan}", "-i", "{in}", "-o", "{out}", "-n", "realesrgan-x4plus", "-m", "{modelos}"]
  },
  "ia-aumentar-anime": {
    "rotulo": "Aumentar 4x — desenho/anime (IA)",
    "categoria": "ia",
    "exts": [".jpg", ".jpeg", ".png", ".webp"],
    "cmd": ["{realesrgan}", "-i", "{in}", "-o", "{out}", "-n", "realesrgan-x4plus-anime", "-m", "{modelos}"]
  },
  "ia-melhorar": {
    "rotulo": "Melhorar a qualidade sem aumentar (IA)",
    "categoria": "ia",
    "exts": [".jpg", ".jpeg", ".png", ".webp"],
    "saida_ext": ".png",
    "handler": "restaurar"
  },
  "ia-aumentar-video": {
    "rotulo": "Aumentar vídeo 2x (IA — bem demorado)",
    "categoria": "ia",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v"],
    "saida_ext": ".mp4",
    "handler": "video_upscale"
  },
  "video-menor": {
    "rotulo": "Comprimir (recomendado — bom equilíbrio)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".mp4",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-stats", "-i", "{in}", "-c:v", "libx264", "-crf", "26", "-preset", "slow", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "128k", "-y", "{out}"]
  },
  "video-muito-menor": {
    "rotulo": "Comprimir muito (bem menor, perde um pouco)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".mp4",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-stats", "-i", "{in}", "-c:v", "libx264", "-crf", "30", "-preset", "slow", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "96k", "-y", "{out}"]
  },
  "video-pouca-compressao": {
    "rotulo": "Comprimir pouco (quase igual ao original)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".mp4",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-stats", "-i", "{in}", "-c:v", "libx264", "-crf", "21", "-preset", "slow", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "160k", "-y", "{out}"]
  },
  "video-rapido-gpu": {
    "rotulo": "Comprimir rápido (usa a placa de vídeo)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".mp4",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-stats", "-i", "{in}", "-c:v", "av1_amf", "-quality", "quality", "-rc", "qvbr", "-qvbr_quality_level", "30", "-c:a", "aac", "-b:a", "128k", "-y", "{out}"]
  },
  "video-guardar": {
    "rotulo": "Guardar ocupando o mínimo (MUITO lento)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".mkv",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-stats", "-i", "{in}", "-c:v", "libsvtav1", "-crf", "32", "-preset", "6", "-c:a", "libopus", "-b:a", "96k", "-y", "{out}"]
  },
  "video-discord": {
    "rotulo": "Caber em 25 MB (Discord)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".mp4",
    "handler": "video_alvo",
    "alvo_mb": 25
  },
  "video-whatsapp": {
    "rotulo": "Caber em 15 MB (WhatsApp)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".mp4",
    "handler": "video_alvo",
    "alvo_mb": 15
  },
  "video-sem-som": {
    "rotulo": "Tirar o som (rápido, não perde qualidade)",
    "categoria": "video",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v"],
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c", "copy", "-an", "-y", "{out}"]
  },
  "audio-menor": {
    "rotulo": "Comprimir (Opus — formato moderno, menor)",
    "categoria": "audio",
    "exts": [".mp3", ".wav", ".flac", ".m4a", ".ogg", ".opus", ".aac", ".wma"],
    "saida_ext": ".opus",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c:a", "libopus", "-b:a", "128k", "-y", "{out}"]
  },
  "audio-mp3": {
    "rotulo": "Converter p/ MP3 (toca em qualquer lugar)",
    "categoria": "audio",
    "exts": [".wav", ".flac", ".m4a", ".ogg", ".opus", ".aac", ".wma", ".mp3"],
    "saida_ext": ".mp3",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-c:a", "libmp3lame", "-q:a", "0", "-y", "{out}"]
  },
  "audio-do-video": {
    "rotulo": "Tirar só o som do vídeo",
    "categoria": "audio",
    "exts": [".mp4", ".mkv", ".mov", ".avi", ".webm", ".m4v", ".ts", ".wmv", ".flv"],
    "saida_ext": ".opus",
    "cmd": ["{ffmpeg}", "-hide_banner", "-loglevel", "warning", "-i", "{in}", "-vn", "-c:a", "libopus", "-b:a", "128k", "-y", "{out}"]
  },
  "audio-nivelar": {
    "rotulo": "Nivelar o volume (nem baixo nem estourado)",
    "categoria": "audio",
    "exts": [".mp3", ".wav", ".flac", ".m4a", ".ogg", ".opus", ".aac", ".wma"],
    "handler": "normalizar"
  },
  "pdf-menor": {
    "rotulo": "Comprimir (recomendado — boa leitura)",
    "categoria": "pdf",
    "exts": [".pdf"],
    "saida_ext": ".pdf",
    "cmd": ["{gs}", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.5", "-dPDFSETTINGS=/ebook", "-dNOPAUSE", "-dBATCH", "-dQUIET", "-sOutputFile={out}", "{in}"]
  },
  "pdf-muito-menor": {
    "rotulo": "Comprimir muito (só p/ ler na tela)",
    "categoria": "pdf",
    "exts": [".pdf"],
    "saida_ext": ".pdf",
    "cmd": ["{gs}", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.5", "-dPDFSETTINGS=/screen", "-dNOPAUSE", "-dBATCH", "-dQUIET", "-sOutputFile={out}", "{in}"]
  },
  "pdf-imprimir": {
    "rotulo": "Comprimir pouco (qualidade p/ imprimir)",
    "categoria": "pdf",
    "exts": [".pdf"],
    "saida_ext": ".pdf",
    "cmd": ["{gs}", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.5", "-dPDFSETTINGS=/printer", "-dNOPAUSE", "-dBATCH", "-dQUIET", "-sOutputFile={out}", "{in}"]
  },
  "compactar-7z": {
    "rotulo": "Compactar no máximo (7z)",
    "categoria": "compactar",
    "exts": ["*"],
    "saida_ext": ".7z",
    "handler": "compactar"
  },
  "compactar-zip": {
    "rotulo": "Compactar em ZIP (abre em qualquer PC)",
    "categoria": "compactar",
    "exts": ["*"],
    "saida_ext": ".zip",
    "handler": "compactar"
  },
  "compactar-partes": {
    "rotulo": "7z em partes de 1 GB (p/ enviar aos poucos)",
